<?xml version="1.0" encoding="utf-8"?>
<!--
    data_extraction_rules.xml
    Disables cloud backup for Smart Copy — no extracted text, preferences,
    or clipboard history should ever leave the device via Android's
    auto-backup mechanism.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
