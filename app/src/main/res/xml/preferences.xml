<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- ── Clipboard Security ── -->
    <PreferenceCategory android:title="Clipboard Security">

        <ListPreference
            android:key="clipboard_ttl"
            android:title="@string/pref_clipboard_ttl_title"
            android:summary="@string/pref_clipboard_ttl_summary"
            android:entries="@array/clipboard_ttl_entries"
            android:entryValues="@array/clipboard_ttl_values"
            android:defaultValue="30"
            app:useSimpleSummaryProvider="false" />

    </PreferenceCategory>

    <!-- ── Trigger & Overlay ── -->
    <PreferenceCategory android:title="Trigger &amp; Overlay">

        <SwitchPreferenceCompat
            android:key="edge_bubble_enabled"
            android:title="@string/pref_edge_bubble_title"
            android:summary="@string/pref_edge_bubble_summary"
            android:defaultValue="true" />

        <ListPreference
            android:key="edge_bubble_side"
            android:title="@string/pref_edge_bubble_side_title"
            android:entries="@array/edge_bubble_side_entries"
            android:entryValues="@array/edge_bubble_side_values"
            android:defaultValue="right"
            android:dependency="edge_bubble_enabled"
            app:useSimpleSummaryProvider="true" />

    </PreferenceCategory>

    <!-- ── Magnifier ── -->
    <PreferenceCategory android:title="Precision Loupe">

        <SeekBarPreference
            android:key="magnifier_zoom"
            android:title="@string/pref_magnifier_zoom_title"
            android:defaultValue="3"
            android:max="5"
            app:min="2"
            app:showSeekBarValue="true" />

    </PreferenceCategory>

    <!-- ── Haptic ── -->
    <PreferenceCategory android:title="Feedback">

        <SwitchPreferenceCompat
            android:key="haptic_feedback"
            android:title="@string/pref_haptic_title"
            android:summary="@string/pref_haptic_summary"
            android:defaultValue="true" />

    </PreferenceCategory>

    <!-- ── About / Supporters Hub ── -->
    <PreferenceCategory android:title="@string/about_title">

        <Preference
            android:key="about_version"
            android:title="@string/about_version_title"
            app:useSimpleSummaryProvider="false" />

        <Preference
            android:key="about_open_source"
            android:title="@string/about_open_source_title"
            android:summary="@string/about_open_source_summary" />

        <Preference
            android:key="about_supporters"
            android:title="@string/about_supporters_title"
            android:summary="@string/about_supporters_summary" />

    </PreferenceCategory>

</PreferenceScreen>
