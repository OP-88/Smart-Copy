<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Smart Copy uses Material3 dark theme as its base.
        Light mode is intentionally not supported — the app
        is permanently dark per brand identity.
    -->
    <style name="Theme.SmartCopy" parent="Theme.Material3.Dark">
        <item name="colorPrimary">@color/primary_cyan</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/primary_cyan_dark</item>

        <item name="android:colorBackground">@color/background_dark</item>
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>

        <item name="colorError">@color/error_red</item>

        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/background_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <!-- Settings activity inherits main theme -->
    <style name="Theme.SmartCopy.Settings" parent="Theme.SmartCopy">
        <item name="android:windowBackground">@color/surface_dark</item>
    </style>
</resources>
